# Files excluded from the published pub.dev archive.
#
# A `.pubignore` replaces only a `.gitignore` in its own directory, and this
# package has none: the repository root `.gitignore` still applies, so only the
# publish-only exclusions are listed here. Verify with
# `flutter pub publish --dry-run`.
#
# This is a gitignore-syntax file, not Markdown: the `*` globs below are
# patterns, not emphasis. See .vscode/settings.json for the file association
# that keeps editors from reformatting them.

# --- Publish-only exclusions -------------------------------------------------

# The sample app's platform scaffolding. `example/lib/`, `example/test/` and
# `example/README.md` stay in the archive: pub.dev renders them as the package's
# Example tab, and pana scores their presence. The generated Android/iOS/web/
# desktop projects around them are pure bulk to a consumer.
/example/android/
/example/ios/
/example/linux/
/example/macos/
/example/windows/
/example/web/
/example/.metadata
/example/env.example.json
/example/analysis_options.yaml

# The SDK's own test suite. Consumers never run it.
/test/

# Package tooling: the version-sync script. Only meaningful when working on the
# SDK itself.
/tool/
/.metadata
/configdirector_flutter_client_sdk.iml
